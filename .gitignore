# Build output (bundlers: vite / webpack / parcel / next / rollup)
dist/
dist-ssr/
build/
out/
# `web/tune/build_static.py --dist public` assembles the deployed tuner here, and the
# `pages` job rebuilds it in CI. It is generated from tracked sources every time; a
# committed copy would just go stale against the page it was built from.
/public/
.next/
.nuxt/
.svelte-kit/
.parcel-cache/
.cache/
.vite/
*.local

# ---------------------------------------------------------------------------
# WASM toolchains
# ---------------------------------------------------------------------------
# Rust / wasm-pack / wasm-bindgen
target/
Cargo.lock.bak
pkg/
wasm-pack.log

# Emscripten
.emscripten_cache/
.emscripten_ports/
emsdk/
*.wasm.map
*.worker.js.map

# Generated glue code is usually a build artifact, not source.
# If you decide to commit prebuilt wasm, un-ignore explicitly, e.g.:
#   !web/public/wasm/oilpaint.wasm
*.wasm
*.wast

