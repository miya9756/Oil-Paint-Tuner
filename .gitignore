out/
outputs/
renders/
frames/
checkpoints/
logs/
runs/
wandb/
mlruns/
*.mp4
*.avi
*.mov
*.gif.tmp

# data/samples/ holds local test images copied from the site repo, including a personal
# photograph. Ignored by default rather than pushed to LFS on a shared remote -- un-ignore
# deliberately if a curated, publishable test set is wanted here.
data/samples/

# Note: assets/ is intentionally NOT ignored -- small curated inputs live there and are
# tracked through Git LFS (see .gitattributes).

